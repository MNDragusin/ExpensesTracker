@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@using ExpensesTracker.Common.Dtos
 
<EditForm Model="dataModel" OnValidSubmit="OnSubmit">
    <Modal @ref="modal">
        <Title>
            <h5 class="modal-title">@Title</h5>
        </Title>
        <Body>
        
        <div class="form-group">
            <label for="date">Date</label>
            <input type="date" class="form-control" id="date" @bind="@dataModel.Date" />
        </div>
        <div class="form-group">
            <label for="amount">Amount</label>
            <input type="number" class="form-control" id="amount" @bind="@dataModel.Amount"/>
        </div>
        <div class="form-group">
            <label for="category">Category</label>
            <select class="form-control" id="category" @bind="@dataModel.CategoryId">
                @foreach(var cat in Categories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="label">Label</label>
            <select class="form-control" id="label" @bind="@dataModel.LabelId">
                @foreach(var lbl in Labels)
                {
                    <option value="@lbl.Id">@lbl.Name</option>
                }
            </select>
        </div>

        </Body>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Close</button>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </Footer>
    </Modal>
</EditForm>


@code {
    [Parameter]
    public Action<EntryDto> OnSaveCallback { get; set; }

    [Parameter] 
    public string Title { get; set; }
    
    [Parameter]
    public List<CategoryDto> Categories { get; set; }
    
    [Parameter]
    public List<LabelDto> Labels { get; set; }
    
    private Modal modal;
    private EntryDto dataModel = new();

    public void ShowModal()
    {
        dataModel.Date = DateOnly.FromDateTime(DateTime.Now);
        modal.Open();
    }

    public void CloseModal()
    {
        modal.Close();
    }

    private void OnSubmit()
    {
        OnSaveCallback?.Invoke(dataModel);
        modal.Close();
    }
}
