@page "/auth"

@using ExpensesTracker.Client.Components
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))

<PageTitle>Wallet: ##Template##</PageTitle>

<h1>Wallet: ##Template##</h1>

<AuthorizeView>
    <div class="alert alert-info" role="alert">
        <h4 class="alert-heading">Dev info</h4>
        <hr />
        <p>Hello @context.User.Identity?.Name! - @context.User.Identity!.AuthenticationType</p>
        <p>@context.User.Claims.FirstOrDefault().Value</p>
    </div>

    <div class="btn-group" role="group" aria-label="edit buttons">
        <button class="btn btn-primary">New Wallet</button>
        <button class="btn btn-primary" @onclick="ShowAddNew">New Entry</button>
    </div>
    
    <div class="btn-group">
        <button class="btn btn-primary">Categories</button>
        <button class="btn btn-primary" @onclick="ShowEditCategory">+</button>
    </div>

    <div class="btn-group">
        <button class="btn btn-primary">Labels</button>
        <button class="btn btn-primary" @onclick="ShowEditLabel">+</button>
    </div>
    
    <div class="row">
        <table class="table">
            <thead>
                <tr style="text-align: center">
                    <th class="w-20" scope="col">Date</th>
                    <th class="w-20" scope="col">Amount</th>
                    <th class="w-20" scope="col">Category</th>
                    <th class="w-20" scope="col">Label</th>
                    <th class="w-20" scope="col"></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>

    <Modal @ref="modal">
        <Title>
            <h5 class="modal-title">@modalTitle</h5>
        </Title>
        <Body>
            @details
        </Body>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="() => modal.Close()">Close</button>
            <button type="button" class="btn btn-primary">Save changes</button>
        </Footer>
    </Modal>
</AuthorizeView>

@code {
    private Modal? modal { get; set; }
    private RenderFragment? details { get; set; }
    private string modalTitle { get; set; }
    private void ShowAddNew()
    {
        modalTitle = "Add new expense";
        details = builder =>
        {
            builder.OpenComponent<ExpensesDetails>(0);
            builder.CloseComponent();
        };

        modal.Open();
    }

    private void ShowEditCategory()
    {
        modalTitle = "Edit Category";
        details = builder =>
        {
            builder.OpenComponent<CategoryDetails>(0);
            builder.CloseComponent();
        };

        modal.Open();
    }

    private void ShowEditLabel()
    {
        modalTitle = "Edit Label";
        details = builder =>
        {
            builder.OpenComponent<CategoryDetails>(0);
            builder.CloseComponent();
        };

        modal.Open();
    }
}
