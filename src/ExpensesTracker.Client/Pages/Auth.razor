@page "/auth"

@using ExpensesTracker.Client.Components
@using ExpensesTracker.Client.ViewModels
@using ExpensesTracker.Common.Dtos
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))

@implements IDisposable
@inject WalletViewModel ViewModel

<PageTitle>@ViewModel.WalletData.Name</PageTitle>

<h1>@ViewModel.WalletData.Name</h1>

<AuthorizeView>
    <div class="alert alert-info" role="alert">
        <h4 class="alert-heading">Dev info</h4>
        <hr />
        <p>Hello @context.User.Identity?.Name! - @context.User.Identity!.AuthenticationType</p>
        <p>@context.User.Claims.FirstOrDefault().Value</p>
    </div>

    <div class="btn-group" role="group" aria-label="edit buttons">
        <button class="btn btn-primary" @onclick="ShowNewWallet">New Wallet</button>
        <button class="btn btn-primary" @onclick="ShowAddNew">New Entry</button>
    </div>
    
    <div class="btn-group">
        <button class="btn btn-primary">Categories</button>
        <button class="btn btn-primary" @onclick="ShowEditCategory">+</button>
    </div>

    <div class="btn-group">
        <button class="btn btn-primary">Labels</button>
        <button class="btn btn-primary" @onclick="ShowEditLabel">+</button>
    </div>
    
    <div class="row">
        <table class="table">
            <thead>
                <tr style="text-align: center">
                    <th class="w-20" scope="col">Date</th>
                    <th class="w-20" scope="col">Amount</th>
                    <th class="w-20" scope="col">Category</th>
                    <th class="w-20" scope="col">Label</th>
                    <th class="w-20" scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in ViewModel.WalletData.Entries)
                {
                    <tr style="text-align: center">
                        <td>@entry.Date.ToShortDateString()</td>
                        <td>@entry.Amount.ToString("C")</td>
                        <td>@ViewModel.Categories.Find(c=>c.Id == entry.CategoryId).Name</td>
                        <td>@ViewModel.Labels.Find(l=>l.Id == entry.LabelId).Name</td>
                        <td>
                            <button class="btn btn-primary" @onclick="() => ShowEditCategory()">Edit</button>
                            <button class="btn btn-danger" @onclick="() => ViewModel.DeleteEntry(entry.EntryId)">Delete</button>
                        </td>
                    </tr>
                }
            
            </tbody>
        </table>
    </div>
    <CategoryDetails @ref="walletModal" Title="@genericModalTitle" />
    <ExpensesDetails @ref="expensesModal" Title="@entryModalTitle" Categories="@ViewModel.Categories" Labels="@ViewModel.Labels"/>
</AuthorizeView>

@code {

    //modal data for wallet,category and label
    private string genericModalTitle { get; set; }
    private CategoryDetails walletModal { get; set; }

    //modal for wallet entry
    private string entryModalTitle { get; set; }
    private ExpensesDetails expensesModal { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ViewModel.PropertyChanged += (_, __) => InvokeAsync(StateHasChanged);
    }

    private void ShowAddNew()
    {
        entryModalTitle = "New Entry";
        expensesModal.OnSaveCallback += AddNewEntry;
        expensesModal.ShowModal();
    }

    private void ShowEditCategory()
    {
        genericModalTitle = "New Category";
        walletModal.OnSaveCallback += AddNewCategory;
        walletModal.ShowModal();
    }

    private void ShowEditLabel()
    {
        genericModalTitle = "New Label";
        walletModal.OnSaveCallback += AddNewLabel;
        walletModal.ShowModal();
    }

    private void ShowNewWallet()
    {
        genericModalTitle = "New Wallet";
        walletModal.OnSaveCallback += AddNewWallet;
        walletModal.ShowModal();

    }

    private void AddNewWallet(BaseDto dto)
    {
        walletModal.OnSaveCallback -= AddNewWallet;
        ViewModel.CreateWallet(dto);
    }

    private void AddNewCategory(BaseDto dto)
    {
        walletModal.OnSaveCallback -= AddNewCategory;
        ViewModel.CreateCategory(dto);
    }

    private void AddNewLabel(BaseDto dto)
    {
        walletModal.OnSaveCallback -= AddNewLabel;
        ViewModel.CreateLabel(dto);
    }

    private void AddNewEntry(EntryDto entry)
    {
        expensesModal.OnSaveCallback -= AddNewEntry;
        ViewModel.CreateEntry(entry);
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= (_, __) => InvokeAsync(StateHasChanged);
    }

}
